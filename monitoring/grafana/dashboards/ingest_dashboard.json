{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "gauge",
      "title": "Ingestion Error Rate (%)",
      "id": 1,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (rate(ingest_requests_total{result=\"error\"}[5m]) / clamp_min(sum(rate(ingest_requests_total[5m])), 1e-6))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "gauge",
      "title": "Skipped / Total Ratio (%)",
      "id": 2,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (rate(ingest_requests_total{result=\"skipped\"}[5m]) / clamp_min(sum(rate(ingest_requests_total[5m])), 1e-6))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Ingestion Throughput (req/s)",
      "id": 3,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(ingest_requests_total[5m]))",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "rate(ingest_requests_total{result=\"error\"}[5m])",
          "legendFormat": "error",
          "refId": "B"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Ingestion Counts by Result",
      "id": 4,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (result) (rate(ingest_requests_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Ingestion Latency (p95) — placeholder",
      "id": 5,
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ingest_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "description": "If you have latency histograms (ingest_latency_seconds_bucket), this will show p95. Remove if not available.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 }
    }
  ],
  "schemaVersion": 34,
  "style": "dark",
  "tags": ["monitoring", "ingest"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Ingest / Alerts Overview",
