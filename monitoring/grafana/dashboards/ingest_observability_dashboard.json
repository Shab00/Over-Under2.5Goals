{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "gauge",
      "title": "Ingestion Error Rate (%)",
      "id": 1,
      "datasource": "Prometheus",
      "description": "Percentage of ingestion requests that failed (last 5m)",
      "targets": [
        {
          "expr": "100 * (rate(ingest_requests_total{result=\"error\"}[5m]) / clamp_min(sum(rate(ingest_requests_total[5m])), 1e-6))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "gauge",
      "title": "Skipped Ratio (%)",
      "id": 2,
      "datasource": "Prometheus",
      "description": "Percentage of ingestion requests skipped (duplicates, last 5m)",
      "targets": [
        {
          "expr": "100 * (rate(ingest_requests_total{result=\"skipped\"}[5m]) / clamp_min(sum(rate(ingest_requests_total[5m])), 1e-6))",
          "legendFormat": "Skipped Ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 70 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Webhook Deliveries (Total)",
      "id": 3,
      "datasource": "Prometheus",
      "description": "Total Alertmanager webhook deliveries received (smoke test health)",
      "targets": [
        {
          "expr": "alertmanager_webhook_deliveries_total",
          "legendFormat": "Deliveries",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Ingestion Trends: Success / Skipped / Error (5m rate)",
      "id": 4,
      "datasource": "Prometheus",
      "description": "Time series showing ingestion outcomes over time",
      "targets": [
        {
          "expr": "sum by (result) (rate(ingest_requests_total[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "skipped" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "persisted" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["last", "mean", "max"]
        },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 7 }
    },
    {
      "type": "timeseries",
      "title": "Ingestion Throughput (Total req/s)",
      "id": 5,
      "datasource": "Prometheus",
      "description": "Total ingestion request rate over time",
      "targets": [
        {
          "expr": "sum(rate(ingest_requests_total[5m]))",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "sum(rate(ingest_requests_total{result=\"error\"}[5m]))",
          "legendFormat": "Errors",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Errors" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Webhook Delivery Trend",
      "id": 6,
      "datasource": "Prometheus",
      "description": "Alertmanager webhook deliveries over time (observability canary)",
      "targets": [
        {
          "expr": "increase(alertmanager_webhook_deliveries_total[5m])",
          "legendFormat": "Deliveries (5m)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Alertmanager Notification Failures",
      "id": 7,
      "datasource": "Prometheus",
      "description": "Failed Alertmanager notification deliveries (5m increase)",
      "targets": [
        {
          "expr": "increase(alertmanager_notifications_failed_total[5m])",
          "legendFormat": "Failed Notifications",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30
          },
          "color": { "fixedColor": "red", "mode": "fixed" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["ingest", "observability", "saas", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SaaS Ingestion & Observability",
  "uid": "saas-ingest-obs",
  "version": 1
}
