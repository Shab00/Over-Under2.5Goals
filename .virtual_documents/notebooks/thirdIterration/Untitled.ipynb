import os, glob, math
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.linear_model import LogisticRegression
from sklearn.isotonic import IsotonicRegression
from sklearn.metrics import brier_score_loss
import matplotlib.pyplot as plt

SNAP_GLOB = "results/predictions_snapshot_with_calibrated_probs.csv"
OUT_DIR = "results"
os.makedirs(OUT_DIR, exist_ok=True)

snap_list = sorted(glob.glob(SNAP_GLOB))
if not snap_list:
    raise FileNotFoundError(f"No snapshot found matching {SNAP_GLOB}")
snapshot_path = snap_list[-1]
print("Using snapshot:", snapshot_path)

df = pd.read_csv(snapshot_path, low_memory=False)
print("Rows:", len(df))
print("Columns:", df.columns.tolist())

required = ["prob_home","odds_B365H","actual"]
for c in required:
    if c not in df.columns:
        print(f"WARNING: {c} not in snapshot (some operations will be skipped).")

df['prob_home'] = pd.to_numeric(df['prob_home'], errors='coerce')
df['odds_B365H'] = pd.to_numeric(df.get('odds_B365H', pd.Series()), errors='coerce')


known = df[df['actual'].notna()].copy()
if len(known) == 0:
    raise ValueError("No rows with actual present; cannot fit calibrators.")

X = known['prob_home'].astype(float).values.reshape(-1,1)
y = known['actual'].astype(int).values

train_idx, test_idx = train_test_split(np.arange(len(known)), test_size=0.33, stratify=y, random_state=42)
X_train, X_test = X[train_idx], X[test_idx]
y_train, y_test = y[train_idx], y[test_idx]

platt = LogisticRegression(solver='lbfgs')
platt.fit(X_train, y_train)
platt_test_preds = platt.predict_proba(X_test)[:,1]
print("Platt Brier (test):", brier_score_loss(y_test, platt_test_preds))

iso = IsotonicRegression(out_of_bounds='clip')
iso.fit(X_train.ravel(), y_train)
iso_test_preds = iso.predict(X_test.ravel())
print("Isotonic Brier (test):", brier_score_loss(y_test, iso_test_preds))

prob_series = df['prob_home'].fillna(0).astype(float).values.reshape(-1,1)
df['prob_platt'] = platt.predict_proba(prob_series)[:,1]
df['prob_isotonic'] = iso.predict(prob_series.ravel())

print("Brier raw (all known):", brier_score_loss(known['actual'], known['prob_home']))
print("Brier platt (all known):", brier_score_loss(known['actual'], platt.predict_proba(known['prob_home'].values.reshape(-1,1))[:,1]))
print("Brier iso (all known):", brier_score_loss(known['actual'], iso.predict(known['prob_home'].values)))


df['odds_B365H'] = pd.to_numeric(df['odds_B365H'], errors='coerce')
df['implied'] = np.where(df['odds_B365H']>0, 1.0 / df['odds_B365H'], np.nan)

df['edge_raw'] = df['prob_home'] - df['implied']
df['edge_platt'] = df['prob_platt'] - df['implied']
df['edge_iso'] = df['prob_isotonic'] - df['implied']

df['exp_return_raw'] = df['prob_home'] * df['odds_B365H'] - 1.0
df['exp_return_platt'] = df['prob_platt'] * df['odds_B365H'] - 1.0
df['exp_return_iso'] = df['prob_isotonic'] * df['odds_B365H'] - 1.0

def pnl_val(r):
    if pd.isna(r.get('actual')):
        return np.nan
    return (r['odds_B365H'] - 1.0) if int(r['actual']) == 1 else -1.0

df['pnl_1unit'] = df.apply(pnl_val, axis=1)

calibrated_path = os.path.join(OUT_DIR, "predictions_snapshot_with_calibrated_probs.csv")
df.to_csv(calibrated_path, index=False)
print("Saved calibrated snapshot:", calibrated_path)


def threshold_sweep(df, prob_col, thresholds=None):
    if thresholds is None:
        thresholds = np.round(np.arange(0.30, 0.805, 0.01), 3)
    rows = []
    for t in thresholds:
        sel = df[df[prob_col] >= t]
        n = len(sel)
        wins = int(sel['actual'].sum()) if ('actual' in sel.columns and sel['actual'].notna().sum()>0) else np.nan
        win_rate = wins / n if n>0 and not np.isnan(wins) else np.nan
        total_pnl = sel['pnl_1unit'].sum() if 'pnl_1unit' in sel.columns else np.nan
        roi = total_pnl / n if n>0 else np.nan
        avg_edge = sel[[c for c in ['edge_raw','edge_platt','edge_iso'] if c.endswith(prob_col.split('_')[-1]) or c.endswith('raw')]].mean(axis=1).mean() if n>0 else np.nan
        rows.append({'threshold':t, 'n_bets':n, 'wins':wins, 'win_rate':win_rate,
                     'total_pnl':total_pnl, 'roi':roi, 'avg_edge':sel[[c for c in ['edge_raw','edge_platt','edge_iso'] if c in sel.columns]].mean().mean() if n>0 else np.nan})
    return pd.DataFrame(rows)

sweep_raw = threshold_sweep(df, 'prob_home')
sweep_platt = threshold_sweep(df, 'prob_platt')
sweep_iso = threshold_sweep(df, 'prob_isotonic')

sweep_raw.to_csv(os.path.join(OUT_DIR, "threshold_sweep_raw.csv"), index=False)
sweep_platt.to_csv(os.path.join(OUT_DIR, "threshold_sweep_platt.csv"), index=False)
sweep_iso.to_csv(os.path.join(OUT_DIR, "threshold_sweep_isotonic.csv"), index=False)
print("Saved threshold sweep CSVs to", OUT_DIR)



